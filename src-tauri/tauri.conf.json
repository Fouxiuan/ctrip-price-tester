{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "携程查价测试台",
  "version": "0.2.0",
  "identifier": "cn.gdyueshidai.ctrip-price-tester",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5288",
    "beforeDevCommand": "node node_modules/vite/bin/vite.js --host 127.0.0.1 --port 5288",
    "beforeBuildCommand": "node node_modules/vite/bin/vite.js build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "携程查价测试台",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 620,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "resources/node/**/*": "resources/node/"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEQzUzQzlBQUZDNTVBRTMKUldUaldzV3ZtanpGYmI0MGpySit2TzI1RkdxSTBFbXdJYmUwOEQyRTFuSXhaYUFVNlEyOVRrREMK",
      "endpoints": [
        "https://github.com/Fouxiuan/ctrip-price-tester/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
